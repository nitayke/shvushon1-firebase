{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "shvushon1.vercel.app" }],
      "destination": "https://www.shvushon.com/$1",
      "permanent": true
    }
  ],
  "crons": [
    { "path": "/api/analytics", "schedule": "0 3 * * *" }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
